# Database: SQLite for local zero-dependency development; PostgreSQL in production
DATABASE_URL="file:./dev.db"

# Session & JWT Secret (32+ random characters)
AUTH_SECRET="apex_uae_real_estate_jwt_secret_key_change_in_production_32char"

# Application Brand & Localization Defaults
NEXT_PUBLIC_APP_NAME="Apex UAE - Real Estate Supervision OS"
NEXT_PUBLIC_DEFAULT_CURRENCY="AED"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Dubai"
